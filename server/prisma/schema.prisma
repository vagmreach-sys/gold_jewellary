generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid())
  mobile               String               @unique
  passwordHash         String?
  role                 String               @default("CUSTOMER")
  name                 String?
  email                String?
  lastLoginAt          DateTime?
  productTermsAcceptedAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  addresses            Address[]
  orders               Order[]
  carts                Cart[]
  sessions             Session[]
  paymentTransactions  PaymentTransaction[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpChallenge {
  id        String   @id @default(uuid())
  mobile    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile])
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String   @default("Home")
  recipientName  String
  phone          String
  line1          String
  line2          String?
  city           String
  state          String
  pincode        String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id            Int               @id @default(autoincrement())
  slug          String            @unique
  title         String
  category      String
  price         Int
  originalPrice Int
  weight        String
  stock         Int
  rating        Float
  imageSvg      String
  imageUrl      String?
  isActive      Boolean           @default(true)
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  resLines      ReservationLine[]
  media         ProductMedia[]
}

model StorefrontAd {
  id            String   @id @default(uuid())
  slot          Int
  title         String?
  priceText     String?
  offerText     String?
  description   String?
  linkUrl       String?
  imageUrl      String
  mimeType      String
  fileSizeBytes Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slot])
}

model ProductMedia {
  id            String   @id @default(uuid())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String
  url           String
  mimeType      String
  sortOrder     Int      @default(0)
  isPrimary     Boolean  @default(false)
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  @@index([productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Float
  body      String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Cart {
  id          String       @id @default(uuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       CartItem[]
  reservation Reservation?
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model Reservation {
  id        String            @id @default(uuid())
  cartId    String            @unique
  cart      Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  status    String            @default("ACTIVE")
  lines     ReservationLine[]
}

model ReservationLine {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  status            String
  userId            String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  cartId            String?
  customerName      String
  customerPhone     String
  address           String
  addressLine2      String?
  city              String
  state             String?
  pincode           String
  courier           String?
  subtotal          Int
  gst               Int
  shipping          Int                  @default(0)
  grandTotal        Int
  checkoutSessionId String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime             @default(now())
  items             OrderItem[]
  shipment          Shipment?
  payments          PaymentTransaction[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
  title     String
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          String   @default("RAZORPAY")
  amount            Int
  currency          String   @default("INR")
  status            String
  razorpayOrderId   String?
  razorpayPaymentId String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())
}

model Shipment {
  id      String          @id @default(uuid())
  orderId String          @unique
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  awb     String          @unique
  carrier String
  events  TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  title       String
  description String
  occurredAt  DateTime
  sortOrder   Int
}

model ProductView {
  id        String   @id @default(uuid())
  productId Int
  viewedAt  DateTime @default(now())
}
